// Channel Manager — data model
// Postgres. Generate the client with `npm run -w backend prisma:generate`.
//
// Single-portfolio operation: one Organization (created once) owns every Property.
// `Channel` (the OTA catalogue) is platform-global reference data. Every property-owned
// table still carries `organizationId` (there's only one, but the isolation code is
// unchanged) and most also carry `propertyId` — `User.assignedPropertyId` hard-restricts
// a dedicated property manager/owner's account to just that one property.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform: the single organization (portfolio)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  contactEmail  String
  country       String   @default("US")
  currency      String   @default("USD")
  /// Portfolio-wide on/off switch (e.g. maintenance mode) — super admin only.
  active        Boolean  @default(true)
  /// General settings (org profile) — shown on invoices, the public microsite, etc.
  logoUrl       String   @default("")
  brandColor    String   @default("#356ef4")
  taxId         String   @default("")
  invoiceFooter String   @default("")
  locale        String   @default("en-US")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Commission + Stripe Connect payout account (per-booking head-office cut) ─
  /// Override, in basis points (250 = 2.5%). Null = use the platform default
  /// (PlatformSetting "commission:defaultRateBps"). Admin-settable, 0 to 100%.
  commissionRateBps      Int?
  stripeConnectAccountId String?
  /// not_started | onboarding | active | restricted — kept in sync by the
  /// `account.updated` Stripe webhook.
  stripeConnectStatus    String  @default("not_started")

  users              User[]
  properties         Property[]
  channelConnections ChannelConnection[]
  bookings           Booking[]
  conflictAlerts     ConflictAlert[]
  webhookEvents      WebhookEvent[]
  auditLogs          AuditLog[]
  syncJobs           SyncJob[]
  settings           Setting[]
  expenses           Expense[]
  packages           Package[]
  pricingRules       PricingRule[]
  pricingLogs        PricingLog[]
  payments           Payment[]
  aiSuggestions      AiSuggestion[]
  notificationLogs   NotificationLog[]
  accelerator        Accelerator?
}

/// Platform-wide toggles the super admin controls (not tenant-scoped).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  manager
  viewer
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  name               String
  passwordHash       String
  /// Role *within* the organization. Meaningless for platform staff (isSuperAdmin).
  role               UserRole      @default(viewer)
  /// Platform-level super admin — not a member of any organization, full control.
  isSuperAdmin       Boolean       @default(false)
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Hard-restricts a dedicated property manager/owner to this one property — every
  /// property-scoped route rejects access to any other property's data for this user.
  /// Null means portfolio-wide staff (today's org-member behavior).
  assignedPropertyId String?
  assignedProperty   Property?     @relation("PropertyManager", fields: [assignedPropertyId], references: [id], onDelete: SetNull)
  active             Boolean       @default(true)
  /// Staff directory fields.
  title              String        @default("")
  department         String        @default("")
  phone              String        @default("")
  /// Granular permission overlay checked *in addition to* the role rank above
  /// (e.g. "finance.manage", "notifications.manage") — see lib/permissions.ts.
  permissions        String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  auditLogs          AuditLog[]

  @@index([organizationId])
  @@index([assignedPropertyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Property / inventory structure
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       @unique
  name           String
  address        String       @default("")
  city           String       @default("")
  region         String       @default("")
  country        String       @default("US") // ISO-3166 alpha-2, expected CA / US
  timezone       String       @default("America/New_York")
  currency       String       @default("USD")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roomTypes          RoomType[]
  channelConnections ChannelConnection[]
  bookings           Booking[]
  expenses           Expense[]
  packages           Package[]
  pricingRules       PricingRule[]
  seo                PropertySeo?
  faqs               PropertyFaq[]
  pageContent        PropertyPageContent?
  /// Dedicated manager(s)/owner(s) hard-restricted to this property (see User.assignedPropertyId).
  assignedManagers   User[]               @relation("PropertyManager")

  @@index([organizationId])
}

/// Room category taxonomy for grouping/reporting/OTA mapping.
enum RoomCategory {
  standard
  deluxe
  suite
  family
  accessible
  other
}

model RoomType {
  id           String       @id @default(cuid())
  propertyId   String
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code         String
  name         String
  category     RoomCategory @default(standard)
  totalUnits   Int          @default(1)
  maxOccupancy Int          @default(2)
  basePrice    Decimal      @default(0) @db.Decimal(10, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ratePlans    RatePlan[]
  calendarDays CalendarDay[]
  roomMappings RoomMapping[]
  bookings     Booking[]
  conflicts    ConflictAlert[]
  units        RoomUnit[]
  packages     Package[]
  pricingRules PricingRule[]

  @@unique([propertyId, code])
}

/// A physical/bookable unit within a RoomType — the PMS front-desk + housekeeping
/// tracks status at this level (RoomType.totalUnits is just a count; this is identity).
enum HousekeepingStatus {
  clean
  dirty
  inspected
  out_of_order
}

model RoomUnit {
  id                 String             @id @default(cuid())
  roomTypeId         String
  roomType           RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  unitNumber         String
  housekeepingStatus HousekeepingStatus @default(clean)
  notes              String             @default("")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  bookings Booking[]

  @@unique([roomTypeId, unitNumber])
}

model RatePlan {
  id                 String   @id @default(cuid())
  roomTypeId         String
  roomType           RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  code               String
  name               String
  mealPlan           String   @default("room_only") // room_only | breakfast | half_board | all_inclusive
  cancellationPolicy String   @default("flexible")
  // Optional derived pricing: price = parent rate * (1 + adjustPct/100) + adjustFlat
  derivedFromId      String?
  adjustPct          Float    @default(0)
  adjustFlat         Decimal  @default(0) @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roomMappings RoomMapping[]
  bookings     Booking[]

  @@unique([roomTypeId, code])
}

// ─────────────────────────────────────────────────────────────────────────────
// Channels (OTAs) — platform-global catalogue, tenant connections
// ─────────────────────────────────────────────────────────────────────────────

enum ChannelKind {
  push
  pull
  both
}

model Channel {
  id           String      @id @default(cuid())
  code         String      @unique // matches shared/ota-catalog codes
  name         String
  category     String // global | north_america | direct_misc
  kind         ChannelKind
  authType     String
  markets      String[]
  capabilities String[]
  docsUrl      String      @default("")
  notes        String      @default("")
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  connections ChannelConnection[]
  bookings    Booking[]
}

model ChannelConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channelId      String
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  enabled          Boolean @default(false)
  // Encrypted JSON blob (see crypto.ts). Never returned raw by the API.
  credentials      String  @default("")
  syncAvailability Boolean @default(true)
  syncRates        Boolean @default(true)
  syncRestrictions Boolean @default(true)
  importBookings   Boolean @default(true)
  pushEnabled      Boolean @default(true)
  pullIntervalSec  Int     @default(60)
  /// OTA's own commission (what Booking.com/Expedia/etc. charge the property) — used by
  /// Finance. Distinct from the platform commission on Payment, which is ours.
  commissionPct    Decimal @default(0) @db.Decimal(5, 2)
  /// Set when this connection was auto-created by activating the Accelerator, so plan
  /// channel-connection limits don't count it (it's a paid add-on, not part of the base plan).
  viaAccelerator   Boolean @default(false)
  /// Random token the inbound webhook URL must carry (?secret=) — the webhook route is
  /// public/unauthenticated by necessity (real OTAs call it with no session), and the
  /// propertyCode it also requires is intentionally public (the booking microsite/SEO
  /// surface), so this secret is the only thing standing between that endpoint and anyone
  /// who can look up a property code and POST a fake "booking".
  webhookSecret    String  @default("")

  lastPolledAt DateTime?
  lastPushAt   DateTime?
  lastError    String?
  status       String    @default("disconnected") // disconnected | connected | error

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomMappings RoomMapping[]
  syncJobs     SyncJob[]
  syncLogs     SyncLog[]

  @@unique([propertyId, channelId])
  @@index([organizationId])
}

model RoomMapping {
  id                  String            @id @default(cuid())
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  roomTypeId          String
  roomType            RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlanId          String?
  ratePlan            RatePlan?         @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  externalRoomId     String
  externalRatePlanId String   @default("")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([channelConnectionId, externalRoomId, externalRatePlanId])
  @@index([roomTypeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Availability / Rates / Inventory calendar
// ─────────────────────────────────────────────────────────────────────────────

model CalendarDay {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  price             Decimal @default(0) @db.Decimal(10, 2)
  availableUnits    Int     @default(0)
  minStay           Int     @default(1)
  maxStay           Int     @default(0) // 0 = no cap
  closedToArrival   Boolean @default(false)
  closedToDeparture Boolean @default(false)
  stopSell          Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bookings
// ─────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  confirmed
  modified
  cancelled
  rejected
}

model Booking {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceChannelId String
  sourceChannel   Channel      @relation(fields: [sourceChannelId], references: [id])
  roomTypeId      String?
  roomType        RoomType?    @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  ratePlanId      String?
  ratePlan        RatePlan?    @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  externalRef String
  status      BookingStatus @default(confirmed)
  guestName   String
  guestEmail  String?
  guestPhone  String        @default("")
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  unitsBooked Int           @default(1)
  /// Party size — not reported by every OTA, so these default to a reasonable single
  /// occupant rather than being left unknown; the direct-booking search form always
  /// collects them.
  adults      Int           @default(1)
  children    Int           @default(0)
  currency    String        @default("USD")
  amount      Decimal       @default(0) @db.Decimal(10, 2)

  // Set when the source room could not be mapped to a local RoomType.
  unmapped       Boolean @default(false)
  externalRoomId String  @default("")

  // ── PMS front desk ──────────────────────────────────────────────────────────
  roomUnitId   String?
  roomUnit     RoomUnit? @relation(fields: [roomUnitId], references: [id], onDelete: SetNull)
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  rawPayload Json
  receivedAt DateTime  @default(now())
  bookedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  nights   BookingNight[]
  payments Payment[]

  @@unique([sourceChannelId, externalRef])
  @@index([organizationId, receivedAt])
  @@index([propertyId, checkIn])
  @@index([status])
}

model BookingNight {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  units     Int      @default(1)

  @@unique([bookingId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sync engine
// ─────────────────────────────────────────────────────────────────────────────

enum SyncJobStatus {
  pending
  running
  succeeded
  failed
  dead
}

model SyncJob {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  direction           String // push | pull
  entityType          String // availability | rates | restrictions | booking_ack
  payload             Json
  status              SyncJobStatus     @default(pending)
  attempts            Int               @default(0)
  maxAttempts         Int               @default(6)
  nextRunAt           DateTime          @default(now())
  lastError           String?
  dedupeKey           String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  logs SyncLog[]

  @@index([status, nextRunAt])
  @@index([organizationId])
}

model SyncLog {
  id                  String             @id @default(cuid())
  syncJobId           String?
  syncJob             SyncJob?           @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  direction           String
  entityType          String
  ok                  Boolean
  attempt             Int                @default(1)
  request             Json?
  response            Json?
  message             String             @default("")
  durationMs          Int                @default(0)
  createdAt           DateTime           @default(now())

  @@index([createdAt])
  @@index([ok])
}

// ─────────────────────────────────────────────────────────────────────────────
// Conflicts / audit / settings
// ─────────────────────────────────────────────────────────────────────────────

enum ConflictStatus {
  open
  acknowledged
  resolved
}

model ConflictAlert {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // overbooking | double_booking | rate_mismatch | orphan_mapping
  severity       String         @default("high") // low | medium | high | critical
  roomTypeId     String?
  roomType       RoomType?      @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  fromDate       DateTime?      @db.Date
  toDate         DateTime?      @db.Date
  bookingIds     String[]
  details        Json
  status         ConflictStatus @default(open)
  resolutionNote String         @default("")
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([type])
}

model WebhookEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  channelCode    String
  headers        Json
  body           Json
  processed      Boolean       @default(false)
  error          String?
  createdAt      DateTime      @default(now())

  @@index([channelCode, createdAt])
  @@index([organizationId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId])
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance
// ─────────────────────────────────────────────────────────────────────────────

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category       String // utilities | payroll | maintenance | supplies | marketing | other
  amountCents    Int
  currency       String       @default("USD")
  incurredAt     DateTime     @db.Date
  vendor         String       @default("")
  note           String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organizationId, incurredAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Guest-facing packages (bundles) and payments
// ─────────────────────────────────────────────────────────────────────────────

enum PriceAdjustType {
  flat
  pct
}

model Package {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId      String?
  roomType        RoomType?       @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  name            String
  description     String          @default("")
  priceAdjustType PriceAdjustType @default(flat)
  priceValue      Decimal         @default(0) @db.Decimal(10, 2)
  includedAddons  String[]
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
}

enum PaymentStatus {
  pending
  captured
  failed
  refunded
  partially_refunded
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus @default(pending)
  method         String        @default("card") // card | cash | bank_transfer | other
  /// Which guest-payment gateway processed this (if method is "card") — "stripe" or
  /// "moneris". Refunds must route back through the same one, since each merchant's
  /// Moneris credentials are org-specific while Stripe is the platform's single account.
  gateway        String        @default("stripe")
  gatewayRef     String        @default("")
  refundedCents  Int           @default(0)
  capturedAt     DateTime?

  // ── Platform commission split (guest pays us; we remit the rest to the property) ──
  /// The commission rate actually applied (basis points), captured at charge time so a
  /// later rate change never rewrites history.
  commissionRateBps      Int       @default(0)
  commissionCents        Int       @default(0)
  /// amountCents − commissionCents — what the property is owed for this payment.
  netCents               Int       @default(0)
  /// Set when the split was executed as a Stripe Connect destination charge
  /// (transfer_data.destination) — i.e. the net amount already moved to the property's
  /// own Stripe account automatically. Null means the platform is still holding the
  /// full amount (no Connect account onboarded yet) and owes the property a manual payout.
  transferredToConnectAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([bookingId])
}

/// A direct-booking request that's paying before it becomes a real `Booking` — created
/// when a guest starts checkout on the public booking page, resolved into an actual
/// booking (via the normal `ingestBooking` pipeline, conflict-checked like any channel)
/// only once the gateway confirms payment. Nothing is held/reserved while this is
/// "pending", so an abandoned checkout never ties up inventory; if the room sells out to
/// someone else between checkout start and payment confirmation, the guest's payment is
/// refunded automatically and this row is marked "rejected".
model PendingDirectBooking {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  roomTypeId     String
  checkIn        DateTime
  checkOut       DateTime
  units          Int      @default(1)
  guestName      String
  guestEmail     String
  guestPhone     String   @default("")
  adults         Int      @default(1)
  children       Int      @default(0)
  amountCents    Int
  currency       String
  gateway        String // stripe | moneris
  status         String   @default("pending") // pending | completed | rejected | expired
  bookingId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Revenue management (RMS)
// ─────────────────────────────────────────────────────────────────────────────

enum PricingRuleType {
  occupancy_based
  day_of_week
  lead_time
  length_of_stay
}

model PricingRule {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId     String?
  roomType       RoomType?       @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  name           String
  type           PricingRuleType
  /// Shape depends on `type`:
  ///  occupancy_based: { minOccupancyPct, maxOccupancyPct }
  ///  day_of_week:     { weekdays: number[] }  (0=Sun..6=Sat)
  ///  lead_time:       { maxDaysOut }
  ///  length_of_stay:  { minNights }
  conditions     Json
  adjustPct      Float           @default(0) // e.g. 15 = +15%, -10 = -10%
  priority       Int             @default(0) // higher runs later, so it can override
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([propertyId])
}

model PricingLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomTypeId     String
  date           DateTime     @db.Date
  ruleId         String?
  ruleName       String       @default("")
  previousPrice  Decimal      @db.Decimal(10, 2)
  newPrice       Decimal      @db.Decimal(10, 2)
  reason         String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([roomTypeId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// SEO / GEO / AEO — public booking microsite content
// ─────────────────────────────────────────────────────────────────────────────

model PropertySeo {
  id              String   @id @default(cuid())
  propertyId      String   @unique
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  metaTitle       String   @default("")
  metaDescription String   @default("")
  keywords        String[]
  ogImageUrl      String   @default("")
  published       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// The property's public booking page as a set of designer-editable content blocks —
/// a page builder, not freeform HTML. Editing this is restricted to the organization's
/// `admin` role (enforced in `modules/page-builder.ts`), same as other org-wide,
/// customer-facing settings. `sections` holds an ordered array of
/// `{ id, heading, body }` custom blocks the admin adds beneath the built-in ones.
model PropertyPageContent {
  id               String   @id @default(cuid())
  propertyId       String   @unique
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  heroHeadline     String   @default("")
  heroSubheadline  String   @default("")
  heroImageUrl     String   @default("")
  primaryColor     String   @default("#356ef4")
  aboutText        String   @default("")
  amenities        String[] @default([])
  galleryImageUrls String[] @default([])
  sections         Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

model PropertyFaq {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI suggestions
// ─────────────────────────────────────────────────────────────────────────────

enum AiSuggestionType {
  pricing
  occupancy
  guest_reply
}

enum AiSuggestionStatus {
  new
  applied
  dismissed
}

model AiSuggestion {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           AiSuggestionType
  subject        String
  content        String
  status         AiSuggestionStatus @default(new)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications (email / SMS)
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  email
  sms
}

enum NotificationStatus {
  sent
  failed
  skipped
}

model NotificationLog {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // booking_confirmation | booking_cancelled | overbooking_alert | test | ...
  channel        NotificationChannel
  recipient      String
  status         NotificationStatus
  error          String              @default("")
  createdAt      DateTime            @default(now())

  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Accelerator — a paid add-on that distributes a property to more OTA channels
// ─────────────────────────────────────────────────────────────────────────────

model Accelerator {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  active                Boolean      @default(false)
  priceCentsPaid        Int?
  stripePaymentIntentId String?
  /// Channel codes this activation connected on the org's behalf (see shared/plan-catalog
  /// / PlatformSetting "accelerator:channelCodes" for the current bundle definition).
  boostedChannelCodes   String[]
  activatedAt           DateTime?
  deactivatedAt         DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}
