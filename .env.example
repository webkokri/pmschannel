# ─────────────────────────────────────────────────────────────────────────────
# Channel Manager — environment
# Copy to .env and adjust. All services read this file from the repo root.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local dev: `npm run db` starts an embedded Postgres on port 55432 matching this.
# Production: point this at your managed/cloud Postgres.
# `connection_limit` is explicit rather than left to Prisma's CPU-count-based default
# (which can be as low as ~5 on a small container) — the booking engine briefly holds a
# connection per in-flight advisory lock during a concurrency spike (e.g. several guests
# racing for the same last room), and a too-small pool turns that into connection-pool
# timeouts instead of the bookings just queuing their turn on the lock.
DATABASE_URL="postgresql://cm:cm@127.0.0.1:55432/channel_manager?schema=public&connection_limit=20"

# Embedded dev-DB settings (only used by `npm run db`)
DEV_DB_PORT=55432
DEV_DB_USER=cm
DEV_DB_PASSWORD=cm
DEV_DB_NAME=channel_manager

# API
PORT=4000
NODE_ENV=development
# Public URL of the API, used to build webhook URLs shown in the admin panel
PUBLIC_API_URL=http://localhost:4000

# Auth
JWT_SECRET=dev-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Encryption key for channel credentials at rest (32+ chars). Change in production.
CM_SECRET=dev-encryption-key-change-me-please-32b

# Seed accounts (created by `npm run seed`)
SEED_ADMIN_EMAIL=admin@channelmanager.local
SEED_ADMIN_PASSWORD=admin12345
SEED_SUPERADMIN_EMAIL=superadmin@channelmanager.local
SEED_SUPERADMIN_PASSWORD=superadmin12345

# Worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_PULL_INTERVAL_MS=60000

# Public URL of the admin panel itself — used to build links back into the app
# (e.g. Stripe Checkout success/cancel redirects). In prod this is the same origin
# as PUBLIC_API_URL once the API serves the built frontend.
PUBLIC_APP_URL=http://localhost:5173

# Optional — Stripe billing. Leave blank to run with manual/offline billing only
# (self-serve upgrades are recorded for the super admin / support manager to action).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend (Vite) — dev proxy target
VITE_API_URL=http://localhost:4000
